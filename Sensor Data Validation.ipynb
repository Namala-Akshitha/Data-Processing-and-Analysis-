   "source": [
    "sensor_readings = [3, 4, 7, 8, 10, 12, 5]\n",
    "valid_readings = []\n",
    "for hour_index,value in enumerate(sensor_readings):\n",
    "    if value%2==0:\n",
    "        valid_readings.append((hour_index, value))\n",
    "print(\"Valid Sensor Readings (Hour, Value):\")\n",
    "print(valid_readings)"
   ],
